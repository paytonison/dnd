  "buildPresets":[{"name":"debug","configurePreset":"debug"},{"name":"release","configurePreset":"release"},{"name":"headless","configurePreset":"headless"}],
  "testPresets":[{"name":"debug","configurePreset":"debug","output":{"outputOnFailure":true}},{"name":"headless","configurePreset":"headless","output":{"outputOnFailure":true}}]
}
